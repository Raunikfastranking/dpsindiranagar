RewriteEngine On

# Redirect anything starting with /Site to homepage
# RewriteCond %{REQUEST_URI} ^/Site [NC]
# RewriteRule ^.*$ https://dpsindiranagar.com/? [R=301,L]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect all HTTP to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]



# Redirect .php to clean URL
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally rewrite clean URLs to actual .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+)$ $1.php [L]
# -----------------------------

# Friendly URL rewrites
RewriteRule ^home index.php [NC,L]
RewriteRule ^blog/([A-Za-z0-9-]+)  detail.php?slug=$1  [NC,L]
RewriteRule ^view/([A-Za-z0-9-]+)  detail-view.php?slug=$1  [NC,L]
